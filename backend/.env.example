# Скопируйте в backend/.env — читается pydantic-settings (env_prefix BACKEND_)
BACKEND_HOST=127.0.0.1
BACKEND_PORT=3000
# BACKEND_RELOAD=True
BACKEND_DB_HOST=localhost
BACKEND_DB_PORT=5432
BACKEND_DB_USER=ozon_fbs_sandbox
BACKEND_DB_PASS=ozon_fbs_sandbox
BACKEND_DB_BASE=ozon_fbs_sandbox
BACKEND_DB_ECHO=False

# Ключи реального Ozon Seller API — только для backend/scripts/fetch_ozon_fixture.py
