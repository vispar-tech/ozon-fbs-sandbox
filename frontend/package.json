{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=26.9.0",
    "pnpm": ">=12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc6 -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc6 -b",
    "prepare": "cd .. && husky frontend/.husky",
    "generate:types": "openapi-typescript ../ozon-seller-api-schema/schemas/ozon-seller-api-openapi.json -o ./src/shared/model/generated/ozon-api.ts",
    "generate:api-types": "openapi-typescript ../backend/.openapi.json -o ./src/shared/model/generated/backend-api.ts"
  },
  "dependencies": {
    "@floating-ui/react-dom": "^2.1.9",
    "@heroicons/react": "^2.2.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.0.0",
    "eslint-config-love": "^157.0.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "husky": "^9.1.7",
    "openapi-typescript": "^7.9.0",
    "sass": "^1.104.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.58.1",
    "vite": "^8.3.0"
  }
}
