# Свежая схема (cron коммитит ежедневно) + gitlink в индекс.
git submodule update --init --remote ozon-seller-api-schema
git add ozon-seller-api-schema

# Типы backend-контракта: генерируются из схемы самого бэкенда (offline),
# чтобы фронт не разъезжался с его моделями — до typecheck/lint.
make generate-api-types
git add frontend/src/shared/model/generated/backend-api.ts

# Типы из свежей схемы + проверка, что код с ними собирается.
cd frontend
pnpm generate:types
pnpm typecheck
cd ..
git add frontend/src/shared/model/generated/ozon-api.ts

# Все линтеры: расхождение схемы/типов с кодом блокирует коммит.
make lint