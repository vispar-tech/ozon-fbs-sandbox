{
  "name": "ozon-fbs-sandbox",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=26.9.0",
    "pnpm": ">=12"
  },
  "scripts": {
    "dev": "concurrently -n backend,client -c blue,green \"pnpm --filter backend dev\" \"pnpm --filter client dev\"",
    "dev:backend": "pnpm --filter backend dev",
    "dev:client": "pnpm --filter client dev",
    "build": "pnpm --filter backend build && pnpm --filter client build",
    "lint": "eslint .",
    "test": "pnpm --filter backend test"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "eslint": "^10.0.0",
    "eslint-config-love": "^157.0.0",
    "typescript-eslint": "^8.58.1"
  }
}